# ============================================================================
# Copy to .env and fill in. Never commit .env itself.
# ============================================================================

# --- DATABASE ---------------------------------------------------------------
# One of two shapes. DATABASE_URL wins if both are present.
#
# Bluehost: cPanel creates the database and user for you and prefixes both
# with your account name, e.g. myacct_library and myacct_libuser. The host is
# localhost because the database runs on the same server as the app.
DB_USER=youracct_libuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youracct_library

# Or a single connection string, for a hosted database elsewhere
# (Supabase, Neon, Railway). Use this if Bluehost has no PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- PORT -------------------------------------------------------------------
# Bluehost's Node.js selector (Passenger) sets PORT itself — leave this unset
# there. 5000 is for your PC.
PORT=5000

# --- FRONTEND ---------------------------------------------------------------
# Where the built React app lives, so this process can serve it. Leave unset
# and the app checks back-end/public, then ../front-end/dist.
# FRONTEND_DIST=/home/youracct/library/public

# --- SECURITY ---------------------------------------------------------------
# The password for the 'admin' account created on first boot. The fallback in
# the source code is published in this repository, so set this before the
# server is reachable from the internet.
ADMIN_BOOTSTRAP_PASSWORD=

# Only needed if the frontend is served from a DIFFERENT domain than the API.
# On Bluehost one process serves both, so leave it unset.
# ALLOWED_ORIGINS=https://library.yourdomain.com

# Serves the uploads folder as an open static directory — every stored file
# readable by anyone who knows its filename. Local development only.
# NEVER set this to true on a public server.
# SERVE_UPLOADS_STATIC=true

# --- REMOTE FILE STORAGE (not needed on Bluehost) ---------------------------
# Only for hosts that wipe the filesystem on restart, such as Render's free
# tier. Bluehost has a persistent disk, so uploads live in back-end/uploades.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=documents
