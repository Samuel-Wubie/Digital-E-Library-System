# ============================================================================
# Apache rules for the built React app on Bluehost.
#
# Vite copies everything in public/ into dist/, so this ships with the build.
#
# You need this ONLY in the fallback setup — the static site on Bluehost with
# the API hosted elsewhere. If the Node.js app serves the build (the normal
# setup in BLUEHOST-DEPLOYMENT.md), Passenger handles routing and cPanel
# writes its own .htaccess, which this must not fight with. In that case
# delete this file from the uploaded dist.
# ============================================================================

# --- SPA routing ------------------------------------------------------------
# React routes like /dashboard are not real folders on disk. Without this,
# Apache returns its own 404 for anything but the home page — including on a
# plain browser refresh, which is the classic "works until I hit F5" bug.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and folders are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is handed to the app.
  RewriteRule . /index.html [L]
</IfModule>

# --- Caching ----------------------------------------------------------------
# Vite fingerprints filenames in assets/ (app.4f2c1a.js), so those can be
# cached hard and forever — a new build produces a new name. index.html must
# never be cached, or browsers keep loading the old build's asset names after
# you deploy and the site breaks in a way that looks random.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico|webp)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>
